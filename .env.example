# Identifiants de l'application PISTE (obligatoires)
LEGIFRANCE_CLIENT_ID=
LEGIFRANCE_CLIENT_SECRET=
# production (défaut) ou sandbox
LEGIFRANCE_ENV=production
# Transport MCP : stdio (défaut) ou http
MCP_TRANSPORT=stdio
MCP_HTTP_ADDR=:8080
# Jeton Bearer exigé sur /mcp en mode http (32 caractères minimum : openssl rand -hex 32)
MCP_AUTH_TOKEN=
# Autoriser le mode http sans jeton (déconseillé)
MCP_ALLOW_UNAUTHENTICATED=false
MCP_MAX_CONCURRENCY=8
LOG_LEVEL=info
